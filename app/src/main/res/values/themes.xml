<resources>
    <style name="Theme.NovaCut" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_surface</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
    </style>

    <style name="NovaCutToolbarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="NovaCutActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
