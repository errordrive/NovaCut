<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 1. TOP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_project_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/project_default_title"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <!-- Resolution Pill -->
        <TextView
            android:id="@+id/btn_resolution_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="1080P ▼"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:background="@color/bg_surface_elevated" />

        <!-- Undo & Redo -->
        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="↶"
            android:textColor="@color/text_white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_redo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="↷"
            android:textColor="@color/text_white"
            android:textSize="20sp" />

        <!-- High-Contrast Export Button -->
        <Button
            android:id="@+id/btn_export"
            style="@style/NovaCutActionButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="@string/action_export"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- 2. INTERACTIVE PREVIEW CANVAS -->
    <FrameLayout
        android:id="@+id/preview_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_canvas">

        <!-- Aspect-Ratio Scaled Canvas Surface -->
        <FrameLayout
            android:id="@+id/canvas_frame"
            android:layout_width="220dp"
            android:layout_height="390dp"
            android:layout_gravity="center"
            android:background="#141416">

            <TextView
                android:id="@+id/tv_canvas_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Preview Canvas\n[9:16 Video Track]"
                android:textColor="@color/text_medium"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Dynamic Selection Bounding Box Indicator -->
            <View
                android:id="@+id/canvas_selection_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_launcher_foreground"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Floating Play/Pause Overlay -->
        <TextView
            android:id="@+id/btn_play_pause"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:background="@color/bg_surface_hover"
            android:alpha="0.8" />
    </FrameLayout>

    <!-- 3. TIMELINE INFO & PLAYHEAD BAR -->
    <LinearLayout
        android:id="@+id/timecode_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/tv_playhead_timecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_total_timecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:04:00"
            android:textColor="@color/text_medium"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Aspect Ratio Badge -->
        <TextView
            android:id="@+id/tv_aspect_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="9:16"
            android:textColor="@color/text_medium"
            android:textSize="12sp"
            android:background="@color/bg_surface_elevated" />

        <!-- Magnet Snapping Toggle Button -->
        <TextView
            android:id="@+id/btn_snap_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🧲 Snap"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. MULTITRACK TIMELINE CONTAINER -->
    <FrameLayout
        android:id="@+id/multitrack_timeline_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/track_bg">

        <!-- Horizontal Scrollable Tracks Surface -->
        <HorizontalScrollView
            android:id="@+id/timeline_horizontal_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/timeline_tracks_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="200dp">

                <!-- Track 1: Text & Subtitle Track -->
                <LinearLayout
                    android:id="@+id/track_text_container"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <!-- Track 2: Secondary PIP / Overlay Track -->
                <LinearLayout
                    android:id="@+id/track_pip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <!-- Track 3: Main Magnetic Video Track -->
                <LinearLayout
                    android:id="@+id/track_main_container"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <!-- Track 4: Audio Track with Waveforms -->
                <LinearLayout
                    android:id="@+id/track_audio_container"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Vertical Fixed Playhead Line with Diamond Marker -->
        <LinearLayout
            android:id="@+id/fixed_playhead_line"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/playhead_coral"
                android:textSize="12sp" />

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@color/playhead_coral" />
        </LinearLayout>
    </FrameLayout>

    <!-- 5. CONTEXTUAL ACTION TOOLBAR SYSTEM (Level 1 & Level 2) -->
    <FrameLayout
        android:id="@+id/bottom_toolbar_frame"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface">

        <!-- Global Toolbar (Level 1: No clip selected) -->
        <HorizontalScrollView
            android:id="@+id/toolbar_global"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <Button android:id="@+id/btn_menu_edit" style="@style/NovaCutToolbarButton" android:text="✂ Edit" />
                <Button android:id="@+id/btn_menu_audio" style="@style/NovaCutToolbarButton" android:text="🎵 Audio" />
                <Button android:id="@+id/btn_menu_text" style="@style/NovaCutToolbarButton" android:text="T Text" />
                <Button android:id="@+id/btn_menu_overlay" style="@style/NovaCutToolbarButton" android:text="⧉ Overlay" />
                <Button android:id="@+id/btn_menu_effects" style="@style/NovaCutToolbarButton" android:text="✨ Effects" />
                <Button android:id="@+id/btn_menu_filters" style="@style/NovaCutToolbarButton" android:text="🎨 Filters" />
                <Button android:id="@+id/btn_menu_ratio" style="@style/NovaCutToolbarButton" android:text="⊡ Ratio" />
                <Button android:id="@+id/btn_menu_adjust" style="@style/NovaCutToolbarButton" android:text="🎚 Adjust" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Clip Contextual Toolbar (Level 2: Clip selected) -->
        <HorizontalScrollView
            android:id="@+id/toolbar_clip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <Button android:id="@+id/btn_clip_split" style="@style/NovaCutToolbarButton" android:text="✂ Split" />
                <Button android:id="@+id/btn_clip_speed" style="@style/NovaCutToolbarButton" android:text="⚡ Speed" />
                <Button android:id="@+id/btn_clip_volume" style="@style/NovaCutToolbarButton" android:text="🔊 Volume" />
                <Button android:id="@+id/btn_clip_trim_head" style="@style/NovaCutToolbarButton" android:text="⇤ Trim Head" />
                <Button android:id="@+id/btn_clip_trim_tail" style="@style/NovaCutToolbarButton" android:text="⇥ Trim Tail" />
                <Button android:id="@+id/btn_clip_transform" style="@style/NovaCutToolbarButton" android:text="🔄 Transform" />
                <Button android:id="@+id/btn_clip_adjust" style="@style/NovaCutToolbarButton" android:text="🎚 Color" />
                <Button android:id="@+id/btn_clip_duplicate" style="@style/NovaCutToolbarButton" android:text="❐ Duplicate" />
                <Button android:id="@+id/btn_clip_delete" style="@style/NovaCutToolbarButton" android:text="🗑 Delete" android:textColor="@color/accent_pink" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>

    <!-- 6. MODAL SUB-PANEL DOCK (Expandable bottom sheets) -->
    <FrameLayout
        android:id="@+id/modal_panel_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface_elevated"
        android:visibility="gone">

        <!-- A. Speed Panel -->
        <LinearLayout
            android:id="@+id/panel_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/panel_speed_title" android:textColor="@color/text_white" android:textStyle="bold" />
                <TextView android:id="@+id/tv_speed_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.0x" android:textColor="@color/accent_cyan" />
            </LinearLayout>

            <SeekBar android:id="@+id/seek_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="10" android:layout_marginTop="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="12dp">
                <Button android:id="@+id/btn_speed_05" style="@style/NovaCutToolbarButton" android:text="0.5x" />
                <Button android:id="@+id/btn_speed_10" style="@style/NovaCutToolbarButton" android:text="1.0x" />
                <Button android:id="@+id/btn_speed_20" style="@style/NovaCutToolbarButton" android:text="2.0x" />
                <Button android:id="@+id/btn_close_panel_speed" style="@style/NovaCutActionButton" android:text="Done" android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- B. Volume & Fades Panel -->
        <LinearLayout
            android:id="@+id/panel_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/panel_volume_title" android:textColor="@color/text_white" android:textStyle="bold" />
                <TextView android:id="@+id/tv_volume_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="@color/accent_cyan" />
            </LinearLayout>

            <SeekBar android:id="@+id/seek_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" android:layout_marginTop="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btn_toggle_fade_in" style="@style/NovaCutToolbarButton" android:text="+1s Fade In" />
                <Button android:id="@+id/btn_toggle_fade_out" style="@style/NovaCutToolbarButton" android:text="+1s Fade Out" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button android:id="@+id/btn_close_panel_volume" style="@style/NovaCutActionButton" android:text="Done" />
            </LinearLayout>
        </LinearLayout>

        <!-- C. Color Grading Adjust Panel -->
        <LinearLayout
            android:id="@+id/panel_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/panel_color_title" android:textColor="@color/text_white" android:textStyle="bold" />

            <!-- Brightness -->
            <TextView android:id="@+id/tv_brightness_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Brightness: 0" android:textColor="@color/text_medium" android:layout_marginTop="8dp" />
            <SeekBar android:id="@+id/seek_brightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

            <!-- Contrast -->
            <TextView android:id="@+id/tv_contrast_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contrast: 0" android:textColor="@color/text_medium" android:layout_marginTop="6dp" />
            <SeekBar android:id="@+id/seek_contrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

            <!-- Saturation -->
            <TextView android:id="@+id/tv_saturation_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saturation: 0" android:textColor="@color/text_medium" android:layout_marginTop="6dp" />
            <SeekBar android:id="@+id/seek_saturation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

            <Button android:id="@+id/btn_close_panel_adjust" style="@style/NovaCutActionButton" android:text="Apply Adjustments" android:layout_gravity="end" android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- D. Aspect Ratio Panel -->
        <LinearLayout
            android:id="@+id/panel_ratio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/panel_ratio_title" android:textColor="@color/text_white" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
                <Button android:id="@+id/btn_ratio_9_16" style="@style/NovaCutToolbarButton" android:text="9:16 (TikTok)" />
                <Button android:id="@+id/btn_ratio_16_9" style="@style/NovaCutToolbarButton" android:text="16:9 (YouTube)" />
                <Button android:id="@+id/btn_ratio_1_1" style="@style/NovaCutToolbarButton" android:text="1:1 (Square)" />
                <Button android:id="@+id/btn_ratio_4_3" style="@style/NovaCutToolbarButton" android:text="4:3 (Classic)" />
            </LinearLayout>

            <Button android:id="@+id/btn_close_panel_ratio" style="@style/NovaCutActionButton" android:text="Done" android:layout_gravity="end" android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- E. Text Overlay Panel -->
        <LinearLayout
            android:id="@+id/panel_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/panel_text_title" android:textColor="@color/text_white" android:textStyle="bold" />

            <EditText
                android:id="@+id/et_text_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@color/bg_surface"
                android:paddingHorizontal="12dp"
                android:hint="Type subtitle / title text here..."
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btn_text_color_cyan" style="@style/NovaCutToolbarButton" android:text="Cyan" android:textColor="@color/accent_cyan" />
                <Button android:id="@+id/btn_text_color_yellow" style="@style/NovaCutToolbarButton" android:text="Yellow" android:textColor="@color/subtitle_amber" />
                <Button android:id="@+id/btn_text_color_white" style="@style/NovaCutToolbarButton" android:text="White" android:textColor="@color/text_white" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button android:id="@+id/btn_add_text_to_timeline" style="@style/NovaCutActionButton" android:text="Add Text" />
            </LinearLayout>
        </LinearLayout>

        <!-- F. Export Modal Panel with Progress Bar -->
        <LinearLayout
            android:id="@+id/panel_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/panel_export_title" android:textColor="@color/text_white" android:textStyle="bold" android:textSize="16sp" />

            <TextView android:id="@+id/tv_export_settings_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Resolution: 1080P | Frame Rate: 30 FPS | Codec: H.264" android:textColor="@color/text_medium" />

            <ProgressBar
                android:id="@+id/progress_export"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_export_progress_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:text="0%"
                android:textColor="@color/accent_cyan"
                android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="16dp">
                <Button android:id="@+id/btn_cancel_export" style="@style/NovaCutToolbarButton" android:text="@string/btn_cancel" />
                <Button android:id="@+id/btn_start_render" style="@style/NovaCutActionButton" android:text="@string/btn_start_export" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
